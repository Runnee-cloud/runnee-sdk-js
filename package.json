{
  "name": "@runnee/sdk",
  "version": "0.1.0",
  "description": "Official server-side JavaScript and TypeScript client for Runnee Cloud",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "main": "./lib/cjs/index.js",
  "module": "./lib/esm/index.js",
  "types": "./lib/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/esm/index.d.ts",
        "default": "./lib/esm/index.js"
      },
      "require": {
        "types": "./lib/cjs/index.d.ts",
        "default": "./lib/cjs/index.js"
      }
    }
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "openapi.json",
    "RELEASING.md"
  ],
  "scripts": {
    "build": "node scripts/build.cjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "prettier": "^3.5.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itzBqa/runnee-sdk-js.git"
  },
  "bugs": {
    "url": "https://github.com/itzBqa/runnee-sdk-js/issues"
  },
  "homepage": "https://runnee.cloud/docs#sdk",
  "keywords": [
    "runnee",
    "serverless",
    "sdk"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
